---
import "../styles/global.css";
import Analytics from "@vercel/analytics/astro";
import { detectLocale, t, counterpartPath, type Locale } from "../lib/i18n";

interface Crumb {
  href?: string;
  /** Either an inline label or an i18n key. */
  label: string;
  muted?: boolean;
}

interface Props {
  title?: string;
  description?: string;
  activeNav?:
    | "about"
    | "research"
    | "people"
    | "news"
    | "articles"
    | "publications"
    | "join"
    | null;
  /** Optional override of the top utility-bar crumb trail. */
  crumbs?: Crumb[];
  /** Drop the territorial acknowledgement + extended footer columns on sub-pages. */
  condensedFooter?: boolean;
  /** Override the auto-detected locale (useful for static page mirrors). */
  locale?: Locale;
}

const pathname = Astro.url.pathname;
const locale: Locale = Astro.props.locale ?? detectLocale(pathname);
const tt = (key: Parameters<typeof t>[1]) => t(locale, key);

const {
  title = locale === "fr"
    ? "LECS — Laboratoire pour les systèmes informatiques émergents · Université Concordia"
    : "LECS — Laboratory for Emerging Computing Systems · Concordia University",
  description = locale === "fr"
    ? "Le Laboratoire pour les systèmes informatiques émergents (LECS) à l'Université Concordia, dirigé par le Pr Sébastien Le Beux. Recherche sur les interconnexions photoniques sur silicium, les architectures reconfigurables, et l'informatique émergente."
    : "The Laboratory for Emerging Computing Systems (LECS) at Concordia University, led by Prof. Sébastien Le Beux. Research on silicon photonic interconnects, reconfigurable architectures, and emerging computing.",
  activeNav = "about",
  crumbs,
  condensedFooter = false
} = Astro.props;

const langHome = locale === "fr" ? "/fr/" : "/";

const defaultCrumbs: Crumb[] = [
  { href: "https://www.concordia.ca", label: tt("util.breadcrumb.concordia") },
  { href: "https://www.concordia.ca/ginacody.html", label: tt("util.breadcrumb.gcs") },
  {
    href: "https://www.concordia.ca/ginacody/electrical-computer-eng.html",
    label: tt("util.breadcrumb.ece")
  },
  { label: "LECS", muted: true }
];
const crumbsToShow = crumbs ?? defaultCrumbs;

const nav = [
  { href: `${langHome}#about`, label: tt("nav.about"), key: "about" },
  { href: `${langHome}#research`, label: tt("nav.research"), key: "research" },
  { href: `${langHome}#people`, label: tt("nav.people"), key: "people" },
  { href: `${langHome}#news`, label: tt("nav.news"), key: "news" },
  { href: locale === "fr" ? "/fr/articles" : "/articles", label: tt("nav.articles"), key: "articles" },
  { href: `${langHome}#publications`, label: tt("nav.publications"), key: "publications" },
  { href: `${langHome}#join`, label: tt("nav.join"), key: "join" }
] as const;

const altPath = counterpartPath(pathname, locale);
const altLabel = tt("lang.toggle");
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="theme-color" content="#912338" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="alternate" hreflang="en" href={locale === "fr" ? counterpartPath(pathname, "fr") : pathname} />
    <link rel="alternate" hreflang="fr" href={locale === "fr" ? pathname : counterpartPath(pathname, "en")} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <div class="util">
      <div class="wrap">
        <nav class="breadcrumb" aria-label="Breadcrumb">
          {
            crumbsToShow.map((c, i) => (
              <>
                {c.href ? (
                  <a href={c.href}>{c.label}</a>
                ) : (
                  <span style={c.muted ? "opacity:.7" : undefined}>{c.label}</span>
                )}
                {i < crumbsToShow.length - 1 && <span class="sep">›</span>}
              </>
            ))
          }
        </nav>
        <div class="actions">
          <a href="mailto:slebeux@encs.concordia.ca">{tt("util.actions.contact")}</a>
          <a href={`${langHome}#join`}>{tt("util.actions.openPositions")}</a>
          <a class="lang" href={altPath} aria-label={tt("lang.label")}>
            {locale === "en" ? <>EN · <strong>FR</strong></> : <><strong>EN</strong> · FR</>}
          </a>
        </div>
      </div>
    </div>

    <header class="header" data-header>
      <div class="wrap">
        <a class="brand" href={langHome}>
          <div class="mark">LECS</div>
          <div class="word">
            <div class="lab">
              {tt("brand.lab")} <span class="lab-for">{tt("brand.for")}</span> {tt("brand.emerging")}
            </div>
            <div class="uni">{tt("brand.affiliation")}</div>
          </div>
        </a>

        <button
          type="button"
          class="hamburger"
          aria-controls="primary-nav"
          aria-expanded="false"
          aria-label={locale === "fr" ? "Ouvrir le menu" : "Open menu"}
          data-hamburger
        >
          <span></span>
          <span></span>
          <span></span>
        </button>

        <nav id="primary-nav" class="nav" aria-label="Primary" data-nav>
          <div class="nav-head">
            <span class="nav-head-label">LECS</span>
            <button
              type="button"
              class="nav-close"
              aria-label={locale === "fr" ? "Fermer le menu" : "Close menu"}
              data-nav-close
            >
              <svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true">
                <path
                  d="M4 4 L16 16 M16 4 L4 16"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  fill="none"
                />
              </svg>
            </button>
          </div>
          {
            nav.map((n) => (
              <a href={n.href} class={n.key === activeNav ? "active" : undefined}>
                {n.label}
              </a>
            ))
          }
          <a class="nav-lang" href={altPath} aria-label={tt("lang.label")} data-nav-lang>
            {locale === "en" ? "Français" : "English"}
          </a>
        </nav>
      </div>
    </header>
    <div class="nav-backdrop" data-nav-backdrop aria-hidden="true"></div>

    <main>
      <slot />
    </main>

    <footer class="foot">
      <div class="wrap">
        {
          !condensedFooter && (
            <p class="land-ack">
              <strong>{tt("foot.landAck.lead")}</strong> {tt("foot.landAck.body")}
            </p>
          )
        }

        <div class="cols">
          <div>
            <h4>{tt("foot.labCol.heading")}</h4>
            <p style="margin-top:0; color:rgba(255,255,255,.78); font-size:14px; max-width:34em;">
              {tt("foot.labCol.body")}
            </p>
            {
              !condensedFooter && (
                <p style="font-size:14px; color:rgba(255,255,255,.78); margin:8px 0 0;">
                  +1 514-848-2424 ×3004 · slebeux (at) encs.concordia.ca
                </p>
              )
            }
          </div>

          <div>
            <h4>{tt("foot.theLab")}</h4>
            <ul>
              <li><a href={`${langHome}#about`}>{tt("nav.about")}</a></li>
              <li><a href={`${langHome}#research`}>{tt("nav.research")}</a></li>
              <li><a href={`${langHome}#people`}>{tt("nav.people")}</a></li>
              <li><a href={`${langHome}#publications`}>{tt("nav.publications")}</a></li>
            </ul>
          </div>

          <div>
            <h4>{tt("foot.resources")}</h4>
            <ul>
              <li>
                <a href="https://scholar.google.com/citations?user=n2zWgXkAAAAJ">
                  {tt("foot.scholar")}
                </a>
              </li>
              <li><a href="http://dblp.uni-trier.de/pers/hd/b/Beux:S=eacute=bastien_Le">{tt("foot.dblp")}</a></li>
              {
                !condensedFooter && (
                  <li>
                    <a href="https://sites.google.com/site/lebeux/">{tt("foot.supervisor")}</a>
                  </li>
                )
              }
              {!condensedFooter && <li><a href={`${langHome}#join`}>{tt("util.actions.openPositions")}</a></li>}
            </ul>
          </div>

          <div>
            <h4>{tt("foot.concordia")}</h4>
            <ul>
              <li><a href="https://www.concordia.ca/ginacody.html">{tt("foot.ginaCody")}</a></li>
              <li>
                <a href="https://www.concordia.ca/ginacody/electrical-computer-eng.html">
                  {tt("foot.eceDept")}
                </a>
              </li>
              {
                !condensedFooter && (
                  <li>
                    <a href="https://www.concordia.ca/research.html">{tt("foot.research")}</a>
                  </li>
                )
              }
              {
                !condensedFooter && (
                  <li>
                    <a href="https://www.concordia.ca/admissions/graduate.html">
                      {tt("foot.grad")}
                    </a>
                  </li>
                )
              }
            </ul>
          </div>
        </div>

        <div class="meta">
          <span>{tt("foot.copyright")}</span>
          <span>
            <a href="https://www.concordia.ca/web/accessibility.html">{tt("foot.accessibility")}</a> ·
            <a href="https://www.concordia.ca/privacy.html">{tt("foot.privacy")}</a> ·
            <a href="https://www.concordia.ca/web/terms.html">{tt("foot.terms")}</a>
          </span>
        </div>
      </div>
    </footer>

    <Analytics />

    <script>
      // Hamburger menu controller. Runs on every page (Layout is shared).
      const btn = document.querySelector<HTMLButtonElement>("[data-hamburger]");
      const nav = document.querySelector<HTMLElement>("[data-nav]");
      const close = document.querySelector<HTMLButtonElement>("[data-nav-close]");
      const backdrop = document.querySelector<HTMLElement>("[data-nav-backdrop]");

      function setOpen(open: boolean) {
        if (!btn || !nav) return;
        btn.setAttribute("aria-expanded", String(open));
        nav.dataset.open = open ? "true" : "false";
        document.documentElement.dataset.menuOpen = open ? "true" : "false";
        if (backdrop) backdrop.dataset.open = open ? "true" : "false";
      }
      function toggle() {
        const current = btn?.getAttribute("aria-expanded") === "true";
        setOpen(!current);
      }

      btn?.addEventListener("click", toggle);
      close?.addEventListener("click", () => setOpen(false));
      backdrop?.addEventListener("click", () => setOpen(false));

      // Close on Escape.
      document.addEventListener("keydown", (e) => {
        if (e.key === "Escape") setOpen(false);
      });

      // Close after the user picks a link.
      nav?.querySelectorAll("a").forEach((a) =>
        a.addEventListener("click", () => setOpen(false))
      );

      // If the viewport grows past the breakpoint while the menu is open, reset.
      const mq = window.matchMedia("(min-width: 901px)");
      mq.addEventListener("change", (e) => { if (e.matches) setOpen(false); });
    </script>
  </body>
</html>

<style>
  .util .lang {
    display: inline-flex;
    gap: 4px;
    align-items: center;
    text-decoration: none;
    color: #e9e6e0;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 12px;
    opacity: 0.85;
  }
  .util .lang:hover { opacity: 1; }
  .util .lang strong { color: #fff; font-weight: 600; }

  /* ===== Hamburger button ===== */
  .hamburger {
    display: none; /* desktop default */
    appearance: none;
    border: 1px solid var(--rule);
    background: transparent;
    width: 44px;
    height: 44px;
    padding: 0;
    margin-left: auto;
    cursor: pointer;
    border-radius: 2px;
    align-items: center;
    justify-content: center;
    flex-direction: column;
    gap: 5px;
    transition: border-color 0.15s ease;
  }
  .hamburger:hover { border-color: var(--maroon); }
  .hamburger:focus-visible {
    outline: 2px solid var(--maroon);
    outline-offset: 2px;
  }
  .hamburger span {
    display: block;
    width: 22px;
    height: 2px;
    background: var(--maroon);
    border-radius: 2px;
    transition: transform 0.2s ease, opacity 0.15s ease;
    transform-origin: center;
  }
  .hamburger[aria-expanded="true"] span:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }
  .hamburger[aria-expanded="true"] span:nth-child(2) { opacity: 0; }
  .hamburger[aria-expanded="true"] span:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }

  /* ===== Nav drawer (mobile) bits ===== */
  .nav .nav-head { display: none; }
  .nav .nav-lang { display: none; }

  .nav-backdrop {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(20, 8, 12, 0.45);
    -webkit-backdrop-filter: blur(2px);
    backdrop-filter: blur(2px);
    z-index: 89;
    opacity: 0;
    transition: opacity 0.2s ease;
    pointer-events: none;
  }
  .nav-backdrop[data-open="true"] {
    display: block;
    opacity: 1;
    pointer-events: auto;
  }

  /* Body-scroll lock when the menu is open. */
  :global(html[data-menu-open="true"]),
  :global(html[data-menu-open="true"] body) {
    overflow: hidden;
  }

  @media (max-width: 900px) {
    .hamburger { display: inline-flex; }

    /* The full nav is hidden by default; toggled via data-open=true. */
    .header .nav {
      position: fixed;
      top: 0;
      right: 0;
      bottom: 0;
      width: min(82vw, 320px);
      background: var(--paper);
      box-shadow: -16px 0 48px -16px rgba(0, 0, 0, 0.35);
      flex-direction: column;
      align-items: stretch;
      justify-content: flex-start;
      gap: 0;
      padding: 0;
      border-top: 0;
      margin-top: 0;
      overflow-y: auto;
      overflow-x: hidden;
      z-index: 90;
      transform: translateX(105%);
      transition: transform 0.25s cubic-bezier(0.32, 0.72, 0.27, 1);
      visibility: hidden;
    }
    .header .nav[data-open="true"] {
      transform: translateX(0);
      visibility: visible;
    }

    .header .nav .nav-head {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 16px 20px;
      border-bottom: 1px solid var(--rule);
    }
    .header .nav .nav-head-label {
      font-family: var(--accent);
      font-weight: 600;
      font-size: 18px;
      letter-spacing: 0.04em;
      color: var(--maroon);
    }
    .header .nav-close {
      appearance: none;
      background: transparent;
      border: 1px solid var(--rule);
      width: 36px;
      height: 36px;
      border-radius: 2px;
      color: var(--ink-2);
      display: grid;
      place-items: center;
      cursor: pointer;
    }
    .header .nav-close:hover { border-color: var(--maroon); color: var(--maroon); }

    .header .nav a {
      padding: 16px 22px;
      font-size: 17px;
      font-weight: 500;
      border-bottom: 1px solid var(--rule-2);
      color: var(--ink);
      width: 100%;
      text-align: left;
      white-space: nowrap;
      border-radius: 0;
    }
    .header .nav a:hover { background: var(--paper-2); color: var(--maroon); }
    .header .nav a.active { color: var(--maroon); background: var(--paper-2); }
    .header .nav a.active::after { display: none; }

    .header .nav .nav-lang {
      display: block;
      margin-top: 16px;
      padding: 14px 22px;
      font-size: 14px;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--maroon);
      border-bottom: 0;
      border-top: 1px solid var(--rule);
    }
  }
</style>
