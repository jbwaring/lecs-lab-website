---
import Avatar from "./Avatar.astro";
import type { PersonEntry } from "../lib/people";
import { detectLocale, t, type Locale } from "../lib/i18n";
import type { StringKey } from "../i18n/strings";

interface Props {
  person?: PersonEntry;
  featured?: boolean;
  locale?: Locale;
}

const { person, featured = false, locale } = Astro.props;
const lang: Locale = locale ?? detectLocale(Astro.url.pathname);
const tt = (k: StringKey) => t(lang, k);

const data = person?.data;
const id = person?.id;
const label = data ? tt(`roleFull.${data.role}` as StringKey) : "";
const bioSnippet =
  featured && data?.bio ? data.bio.split(". ").slice(0, 2).join(". ") + "." : null;
const visibleAreas = (data?.areas ?? []).slice(0, featured ? 6 : 2);

const profileBase = lang === "fr" ? "/fr/profile" : "/profile";
---

{
  person && data && (
    <a
      class:list={["person-card", featured && "featured"]}
      href={`${profileBase}/${id}`}
      data-role={data.role}
    >
      <div class="portrait">
        <Avatar name={data.name} />
      </div>
      <div class="body">
        <span class:list={["role-tag", data.role]}>{label}</span>
        <div class="name">{data.name}</div>
        <div class="pos">{data.title}</div>
        {bioSnippet && <p class="bio-snip">{bioSnippet}</p>}
        <div class="areas">
          {visibleAreas.map((a) => (
            <span>{tt(`area.${a}` as StringKey)}</span>
          ))}
        </div>
        <span class="arrow">{tt("people.viewProfile")}</span>
      </div>
    </a>
  )
}
