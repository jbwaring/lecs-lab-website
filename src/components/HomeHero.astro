---
import { Image } from "astro:assets";
import heroImg from "../assets/hero/laura-ockel-pGVr8YRtQ80-unsplash.jpg";
import { detectLocale, t, type Locale } from "../lib/i18n";
import type { StringKey } from "../i18n/strings";

interface Props {
  publicationsCount: number;
  activeMembers: number;
  yearsAtConcordia: number;
  locale?: Locale;
}

const { publicationsCount, activeMembers, yearsAtConcordia, locale } = Astro.props;
const lang: Locale = locale ?? detectLocale(Astro.url.pathname);
const tt = (k: StringKey) => t(lang, k);
const langHome = lang === "fr" ? "/fr/" : "/";
---

<section class="hero">
  <div class="bg-img-wrap" aria-hidden="true">
    <Image
      src={heroImg}
      alt=""
      class="bg-img"
      widths={[960, 1440, 1920, 2400]}
      sizes="100vw"
      loading="eager"
      decoding="async"
      fetchpriority="high"
    />
    <div class="bg-tint"></div>
  </div>
  <div class="wrap">
    <div class="glass">
      <div class="eyebrow">{tt("hero.eyebrow")}</div>
      <h1>{tt("hero.titleLead")} <em>{tt("hero.titleEm")}</em> {tt("hero.titleTrail")}</h1>
      <p class="lede">{tt("hero.lede")}</p>
      <div class="cta-row">
        <a class="btn primary" href={`${langHome}#research`}>{tt("hero.ctaResearch")}</a>
        <a class="btn ghost" href={`${langHome}#people`}>{tt("hero.ctaPeople")}</a>
      </div>
    </div>

    <div class="stats">
      <div class="stat">
        <div class="num">{publicationsCount}</div>
        <div class="lbl">{tt("hero.stats.papers")}</div>
      </div>
      <div class="stat">
        <div class="num">9</div>
        <div class="lbl">{tt("hero.stats.themes")}</div>
      </div>
      <div class="stat">
        <div class="num">{activeMembers}</div>
        <div class="lbl">{tt("hero.stats.members")}</div>
      </div>
      <div class="stat">
        <div class="num">{yearsAtConcordia}+</div>
        <div class="lbl">{tt("hero.stats.years")}</div>
      </div>
    </div>
  </div>
</section>
<div class="hero-spacer"></div>

<style>
  .hero .bg-img-wrap {
    position: absolute;
    inset: 0;
    z-index: -2;
    overflow: hidden;
  }
  .hero .bg-img-wrap :global(.bg-img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    filter: brightness(0.72) saturate(0.9);
  }
  .hero .bg-tint {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      110deg,
      rgba(74, 18, 30, 0.78) 0%,
      rgba(74, 18, 30, 0.35) 55%,
      rgba(26, 8, 12, 0.55) 100%
    );
  }
</style>
