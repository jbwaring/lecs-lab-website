---
import type { CollectionEntry } from "astro:content";
import { detectLocale, t, type Locale } from "../lib/i18n";
import type { StringKey } from "../i18n/strings";

interface Props {
  pub: CollectionEntry<"publications">;
  /** Author surname to highlight via <mark>. Defaults to "Le Beux". */
  highlightAuthor?: string;
  locale?: Locale;
}
const { pub, highlightAuthor = "Le Beux", locale } = Astro.props;
const lang: Locale = locale ?? detectLocale(Astro.url.pathname);
const tt = (k: StringKey) => t(lang, k);
const p = pub.data;
const pubBase = lang === "fr" ? "/fr/publication" : "/publication";
---

<a
  class="pub-row"
  href={`${pubBase}/${p.slug}`}
  style="color:inherit; text-decoration:none;"
  data-year={p.year}
  data-topics={p.topics.join(",")}
  data-authors={p.authors.join("|")}
  data-search={(p.title + " " + p.authors.join(" ") + " " + p.venue).toLowerCase()}
>
  <div class="pub-type">{p.type}</div>
  <div class="pub-main">
    <div class="title">{p.title}</div>
    <div class="authors">
      {
        p.authors.map((a, j) => (
          <>
            {a.includes(highlightAuthor) ? <mark>{a}</mark> : <span>{a}</span>}
            {j < p.authors.length - 1 ? ", " : ""}
          </>
        ))
      }
    </div>
    <div class="topics">
      {p.topics.map((t) => <span>{tt(`area.${t}` as StringKey)}</span>)}
    </div>
  </div>
  <div class="pub-venue">
    <strong>{p.venue}</strong>
    {p.year}
  </div>
</a>
