---
import { areaTitle } from "../data/lecs";
import type { CollectionEntry } from "astro:content";

interface Props {
  pub: CollectionEntry<"publications">;
  /** Author surname to highlight via <mark>. Defaults to "Le Beux". */
  highlightAuthor?: string;
}
const { pub, highlightAuthor = "Le Beux" } = Astro.props;
const p = pub.data;
---

<a
  class="pub-row"
  href={`/publication/${p.slug}`}
  style="color:inherit; text-decoration:none;"
  data-year={p.year}
  data-topics={p.topics.join(",")}
  data-authors={p.authors.join("|")}
  data-search={(p.title + " " + p.authors.join(" ") + " " + p.venue).toLowerCase()}
>
  <div class="pub-type">{p.type}</div>
  <div class="pub-main">
    <div class="title">{p.title}</div>
    <div class="authors">
      {
        p.authors.map((a, j) => (
          <>
            {a.includes(highlightAuthor) ? <mark>{a}</mark> : <span>{a}</span>}
            {j < p.authors.length - 1 ? ", " : ""}
          </>
        ))
      }
    </div>
    <div class="topics">
      {p.topics.map((t) => <span>{areaTitle[t]}</span>)}
    </div>
  </div>
  <div class="pub-venue">
    <strong>{p.venue}</strong>
    {p.year}
  </div>
</a>
