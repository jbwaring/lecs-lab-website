---
import { areaTitle, type Publication } from "../data/lecs";

interface Props {
  pub: Publication;
  /** Author tag (e.g. "Waring, J.-B.") to highlight via <mark>. Defaults to "Le Beux". */
  highlightAuthor?: string;
}
const { pub, highlightAuthor = "Le Beux" } = Astro.props;
---

<a
  class="pub-row"
  href={`/publication/${pub.slug}`}
  style="color:inherit; text-decoration:none;"
  data-year={pub.year}
  data-topics={pub.topics.join(",")}
  data-authors={pub.authors.join("|")}
  data-search={(pub.title + " " + pub.authors.join(" ") + " " + pub.venue).toLowerCase()}
>
  <div class="pub-type">{pub.type}</div>
  <div class="pub-main">
    <div class="title">{pub.title}</div>
    <div class="authors">
      {
        pub.authors.map((a, j) => (
          <>
            {a.includes(highlightAuthor) ? <mark>{a}</mark> : <span>{a}</span>}
            {j < pub.authors.length - 1 ? ", " : ""}
          </>
        ))
      }
    </div>
    <div class="topics">
      {pub.topics.map((t) => <span>{areaTitle[t]}</span>)}
    </div>
  </div>
  <div class="pub-venue">
    <strong>{pub.venue}</strong>
    {pub.year}
  </div>
</a>
