---
interface Props {
  tag: string;
  title: string;
}
const { tag, title } = Astro.props;

const seed = [...(title ?? "")].reduce((a, c) => (a * 17 + c.charCodeAt(0)) >>> 0, 7);
const rand = (n: number, off = 0) => ((seed >> off) & 0xfff) % n;

const tagMap: Record<string, { bg: string; fg: string; motif: string }> = {
  Paper: { bg: "#4a121e", fg: "#c8a64a", motif: "paper" },
  Award: { bg: "#912338", fg: "#ffd97a", motif: "ribbon" },
  Talk: { bg: "#1a1a1a", fg: "#c8a64a", motif: "wave" },
  Funding: { bg: "#6e1a2b", fg: "#e9c89a", motif: "grid" },
  Defence: { bg: "#912338", fg: "#efeae0", motif: "diploma" },
  Collaboration: { bg: "#4a121e", fg: "#c8a64a", motif: "link" }
};
const cfg = tagMap[tag] ?? tagMap.Paper;

const paperRows = [50, 70, 90, 110, 130, 150];
const gridCells: { r: number; c: number; on: boolean; emph: boolean }[] = [];
if (cfg.motif === "grid") {
  for (let r = 0; r < 6; r++) {
    for (let c = 0; c < 10; c++) {
      gridCells.push({ r, c, on: (r + c + rand(2)) % 3 === 0, emph: (r + c) % 5 === 0 });
    }
  }
}
---

<svg viewBox="0 0 320 200" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
  <rect width="320" height="200" fill={cfg.bg} />
  {Array.from({ length: 8 }).map((_, i) => (
    <line x1={i * 40} y1="0" x2={i * 40} y2="200" stroke="rgba(255,255,255,.04)" />
  ))}

  {cfg.motif === "paper" && (
    <>
      <rect x="80" y="30" width="160" height="140" fill="rgba(255,255,255,.06)" />
      <rect x="80" y="30" width="160" height="140" fill="none" stroke={cfg.fg} stroke-width="1.5" />
      {paperRows.map((y) => (
        <line
          x1="96"
          y1={y}
          x2={y === 50 || y === 150 ? 200 : 224}
          y2={y}
          stroke={cfg.fg}
          stroke-opacity={y === 50 ? 1 : 0.45}
          stroke-width={y === 50 ? 2 : 1}
        />
      ))}
    </>
  )}

  {cfg.motif === "ribbon" && (
    <>
      <circle cx="160" cy="86" r="42" fill="none" stroke={cfg.fg} stroke-width="2" />
      <circle cx="160" cy="86" r="28" fill="none" stroke={cfg.fg} stroke-width="1" />
      <polygon points="140,118 130,176 160,150 190,176 180,118" fill={cfg.fg} opacity="0.85" />
      <text
        x="160"
        y="92"
        text-anchor="middle"
        font-family="Gill Sans, Gill Sans Nova, sans-serif"
        font-size="18"
        font-weight="600"
        fill={cfg.bg}>★</text>
    </>
  )}

  {cfg.motif === "wave" && (
    <>
      {[40, 80, 120, 160].map((y, i) => (
        <path
          d={`M0 ${y} Q80 ${y - 30 + i * 8} 160 ${y} T 320 ${y}`}
          fill="none"
          stroke={cfg.fg}
          stroke-opacity={1 - i * 0.2}
          stroke-width="1.5"
        />
      ))}
      <circle cx="160" cy="100" r="6" fill={cfg.fg} />
    </>
  )}

  {cfg.motif === "grid" && (
    <>
      {gridCells.map((cell) => (
        <rect
          x={20 + cell.c * 30}
          y={30 + cell.r * 25}
          width="20"
          height="15"
          fill={cell.on ? cfg.fg : "rgba(255,255,255,.08)"}
          opacity={cell.emph ? 1 : 0.6}
        />
      ))}
    </>
  )}

  {cfg.motif === "diploma" && (
    <>
      <rect x="60" y="50" width="200" height="100" fill="rgba(255,255,255,.05)" stroke={cfg.fg} />
      <line x1="80" y1="78" x2="240" y2="78" stroke={cfg.fg} stroke-width="2" />
      <line x1="80" y1="98" x2="220" y2="98" stroke={cfg.fg} opacity=".6" />
      <line x1="80" y1="112" x2="200" y2="112" stroke={cfg.fg} opacity=".4" />
      <circle cx="240" cy="135" r="14" fill={cfg.fg} opacity=".85" />
      <polygon points="234,148 234,170 240,162 246,170 246,148" fill={cfg.fg} opacity=".85" />
    </>
  )}

  {cfg.motif === "link" && (
    <>
      <circle cx="120" cy="100" r="36" fill="none" stroke={cfg.fg} stroke-width="3" />
      <circle cx="200" cy="100" r="36" fill="none" stroke={cfg.fg} stroke-width="3" />
      <rect x="148" y="92" width="24" height="16" fill={cfg.bg} />
    </>
  )}

  <text
    x="20"
    y="186"
    font-family="Gill Sans, Gill Sans Nova, sans-serif"
    font-size="11"
    letter-spacing="0.16em"
    fill={cfg.fg}
    opacity="0.85">{tag.toUpperCase()}</text>
</svg>
