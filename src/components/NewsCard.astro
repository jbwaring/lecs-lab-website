---
import NewsThumb from "./NewsThumb.astro";
import { fmtDate, type NewsItem } from "../data/lecs";

interface Props {
  item: NewsItem;
  /** Optional click-through link. When omitted the card is non-interactive. */
  href?: string;
}
const { item, href } = Astro.props;
const interactive = Boolean(href);
---

<a
  class="news-card"
  href={href ?? "#"}
  {...(!interactive ? { onclick: "event.preventDefault()" } : {})}
>
  <div class="thumb">
    <NewsThumb tag={item.tag} title={item.title} />
  </div>
  <div class="meta">
    <span>{fmtDate(item.date)}</span>
    <span class="tag">{item.tag}</span>
  </div>
  <h3>{item.title}</h3>
  <p>{item.summary}</p>
</a>
