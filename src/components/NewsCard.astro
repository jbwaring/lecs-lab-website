---
import NewsThumb from "./NewsThumb.astro";
import { detectLocale, fmtDate, type Locale } from "../lib/i18n";
import type { NewsItem } from "../data/lecs";

interface Props {
  item: NewsItem;
  /** Optional click-through link. When omitted the card is non-interactive. */
  href?: string;
  locale?: Locale;
}
const { item, href, locale } = Astro.props;
const lang: Locale = locale ?? detectLocale(Astro.url.pathname);
const interactive = Boolean(href);
---

<a
  class="news-card"
  href={href ?? "#"}
  {...(!interactive ? { onclick: "event.preventDefault()" } : {})}
>
  <div class="thumb">
    <NewsThumb tag={item.tag} title={item.title} />
  </div>
  <div class="meta">
    <span>{fmtDate(item.date, lang)}</span>
    <span class="tag">{item.tag}</span>
  </div>
  <h3>{item.title}</h3>
  <p>{item.summary}</p>
</a>
