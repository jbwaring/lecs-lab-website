---
import Layout from "../layouts/Layout.astro";
import { detectLocale, t } from "../lib/i18n";
import type { StringKey } from "../i18n/strings";

const lang = detectLocale(Astro.url.pathname);
const tt = (k: StringKey) => t(lang, k);
const langHome = lang === "fr" ? "/fr/" : "/";

const headline = lang === "fr" ? "Cette page est introuvable" : "Sorry, we couldn't find that page";
const sub =
  lang === "fr"
    ? "Le contenu demandé a peut-être été déplacé, renommé, ou n'a jamais existé sur ce site."
    : "The page you requested may have moved, been renamed, or never lived on this site.";
const status = "404";

const links = lang === "fr"
  ? [
      { href: langHome, label: "Page d'accueil" },
      { href: `${langHome}#research`, label: "Axes de recherche" },
      { href: `${langHome}#people`, label: "Équipe" },
      { href: `${langHome}#publications`, label: "Publications" },
      { href: lang === "fr" ? "/fr/articles" : "/articles", label: "Articles" }
    ]
  : [
      { href: langHome, label: "Home" },
      { href: `${langHome}#research`, label: "Research areas" },
      { href: `${langHome}#people`, label: "People" },
      { href: `${langHome}#publications`, label: "Publications" },
      { href: lang === "fr" ? "/fr/articles" : "/articles", label: "Articles" }
    ];

const crumbs = [
  { href: "https://www.concordia.ca", label: tt("util.breadcrumb.concordia") },
  { href: "https://www.concordia.ca/ginacody.html", label: tt("util.breadcrumb.gcs") },
  { href: langHome, label: "LECS" },
  { label: "404", muted: true }
];
---

<Layout
  title={lang === "fr" ? "Page introuvable — LECS · Université Concordia" : "Page not found — LECS · Concordia University"}
  description={sub}
  activeNav={null}
  crumbs={crumbs}
  condensedFooter
  locale={lang}
>
  <section class="nf-hero">
    <div class="wrap">
      <div class="nf-grid">
        <div class="nf-code" aria-hidden="true">{status}</div>
        <div class="nf-body">
          <div class="nf-eyebrow">{lang === "fr" ? "Erreur 404" : "Error 404"}</div>
          <h1>{headline}</h1>
          <p class="lede">{sub}</p>

          <div class="nf-actions">
            <a class="btn primary" href={langHome}>
              ← {lang === "fr" ? "Retour à l'accueil" : "Back to home"}
            </a>
            <a class="btn ghost" href={`mailto:slebeux@encs.concordia.ca`}>
              {lang === "fr" ? "Contacter le laboratoire" : "Contact the lab"}
            </a>
          </div>
        </div>
      </div>

      <div class="nf-links">
        <div class="nf-links-label">{lang === "fr" ? "Vous cherchez peut-être" : "You may be looking for"}</div>
        <ul>
          {links.map((l) => (
            <li>
              <a href={l.href}>{l.label}</a>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>
</Layout>

<style>
  .nf-hero {
    background: var(--maroon-deep);
    color: #f3eee3;
    padding: 88px 0 96px;
    min-height: 70vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    position: relative;
    isolation: isolate;
  }
  .nf-hero::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      radial-gradient(circle at 18% 24%, rgba(200, 166, 74, 0.18), transparent 38%),
      radial-gradient(circle at 84% 78%, rgba(255, 255, 255, 0.06), transparent 42%);
  }

  .nf-grid {
    display: grid;
    grid-template-columns: minmax(0, auto) minmax(0, 1fr);
    gap: 56px;
    align-items: center;
  }
  .nf-code {
    font-family: var(--accent);
    font-weight: 500;
    font-size: clamp(120px, 18vw, 220px);
    line-height: 0.85;
    color: var(--gold);
    letter-spacing: -0.04em;
    opacity: 0.95;
  }
  .nf-body {
    max-width: 32em;
  }
  .nf-eyebrow {
    font-size: 12px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--gold);
    margin-bottom: 14px;
    display: inline-flex;
    align-items: center;
    gap: 10px;
  }
  .nf-eyebrow::before {
    content: "";
    width: 28px;
    height: 1px;
    background: var(--gold);
  }
  .nf-body h1 {
    color: #fff;
    font-size: clamp(32px, 4.2vw, 52px);
    letter-spacing: -0.015em;
    font-weight: 500;
  }
  .nf-body .lede {
    margin-top: 18px;
    color: rgba(255, 255, 255, 0.82);
    font-size: 18px;
  }
  .nf-actions {
    margin-top: 26px;
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .nf-links {
    margin-top: 56px;
    padding-top: 28px;
    border-top: 1px solid rgba(255, 255, 255, 0.15);
  }
  .nf-links-label {
    font-size: 12px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--gold);
    margin-bottom: 14px;
  }
  .nf-links ul {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 6px 24px;
  }
  .nf-links li a {
    display: inline-block;
    padding: 8px 0;
    color: rgba(255, 255, 255, 0.85);
    border-bottom: 1px solid transparent;
    text-decoration: none;
  }
  .nf-links li a:hover {
    color: #fff;
    border-bottom-color: var(--gold);
  }

  @media (max-width: 720px) {
    .nf-grid {
      grid-template-columns: 1fr;
      gap: 12px;
    }
    .nf-code {
      font-size: clamp(96px, 22vw, 160px);
    }
  }
</style>
