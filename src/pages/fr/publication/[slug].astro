---
import Layout from "../../../layouts/Layout.astro";
import Avatar from "../../../components/Avatar.astro";
import { getCollection, type CollectionEntry } from "astro:content";
import { findPersonByAuthorTag } from "../../../lib/people";
import { detectLocale, t } from "../../../lib/i18n";
import type { StringKey } from "../../../i18n/strings";

export async function getStaticPaths() {
  const pubs = await getCollection("publications");
  return pubs.map((p) => ({ params: { slug: p.data.slug }, props: { pub: p } }));
}

type Props = { pub: CollectionEntry<"publications"> };
const { pub } = Astro.props as Props;
const data = pub.data;

const lang = detectLocale(Astro.url.pathname);
const tt = (k: StringKey) => t(lang, k);
const langHome = lang === "fr" ? "/fr/" : "/";
const pubBase = lang === "fr" ? "/fr/publication" : "/publication";
const profileBase = lang === "fr" ? "/fr/profile" : "/profile";
const articleBase = lang === "fr" ? "/fr/article" : "/article";

const people = await getCollection("people");

function makeBibtex(p: typeof data): string {
  const first = p.authors[0]?.split(/[\s,]/)[0]?.toLowerCase().replace(/[^a-z]/g, "") ?? "anon";
  const idTag = (p.arxivId ?? p.semanticScholarId ?? p.slug).replace(/[^a-zA-Z0-9]/g, "");
  if (p.arxivId) {
    return `@misc{${first}${p.year}${idTag},
  title         = {${p.title}},
  author        = {${p.authors.join(" and ")}},
  year          = {${p.year}},
  eprint        = {${p.arxivId}},
  archivePrefix = {arXiv},
  primaryClass  = {${p.primaryCategory ?? "cs.AR"}}
}`;
  }
  const venueLine = p.type === "Journal" ? "journal" : "booktitle";
  return `@${p.type === "Journal" ? "article" : "inproceedings"}{${first}${p.year}${idTag},
  title  = {${p.title}},
  author = {${p.authors.join(" and ")}},
  ${venueLine} = {${p.venue}},
  year   = {${p.year}}${p.doi ? `,\n  doi    = {${p.doi}}` : ""}
}`;
}

const bibtex = makeBibtex(data);

const allPubs = await getCollection("publications");
const related = allPubs
  .filter(
    (p) => p.data.slug !== data.slug && p.data.topics.some((t) => data.topics.includes(t))
  )
  .sort((a, b) => (a.data.date < b.data.date ? 1 : -1))
  .slice(0, 4);

const allArticles = await getCollection("articles");
const relatedArticle = allArticles.find((a) => a.data.relatedPub === data.slug);

const crumbs = [
  { href: "https://www.concordia.ca", label: tt("util.breadcrumb.concordia") },
  { href: "https://www.concordia.ca/ginacody.html", label: tt("util.breadcrumb.gcs") },
  { href: langHome, label: "LECS" },
  { label: tt("nav.publications"), muted: true }
];

const pillLabel = data.arxivId
  ? `arXiv ${data.primaryCategory ?? "preprint"}`
  : data.type;
const canonicalUrl = data.arxivAbs ?? data.paperUrl ?? data.openAccessUrl;
---

<Layout
  title={`${data.title} — LECS · Concordia University`}
  description={data.abstract.slice(0, 220)}
  activeNav="publications"
  crumbs={crumbs}
  condensedFooter
  locale={lang}
>
  <section class="paper-hero">
    <div class="wrap">
      <div class="breadcrumb-mini">
        <a href={langHome}>LECS</a>
        <span>›</span>
        <a href={`${langHome}#publications`}>{tt("nav.publications")}</a>
        <span>›</span>
        <span>{data.year}</span>
      </div>
      <div class="type-pill">{pillLabel}</div>
      <h1>{data.title}</h1>
      <div class="authors-row">
        {
          data.authors.map((a, i) => {
            const person = findPersonByAuthorTag(a, people);
            return (
              <>
                {person ? (
                  <a href={`${profileBase}/${person.id}`}>{a}</a>
                ) : (
                  <span>{a}</span>
                )}
                {i < data.authors.length - 1 ? <span>, </span> : null}
              </>
            );
          })
        }
      </div>
      <div class="venue-row">
        <strong>{data.venue}</strong> · {data.year}
        {data.arxivId && <>  ·  arXiv:{data.arxivId}</>}
        {!data.arxivId && data.doi && <>  ·  DOI: {data.doi}</>}
      </div>
      <div class="pill-row">
        {data.topics.map((tp) => <span class="topic-pill">{tt(`area.${tp}` as StringKey)}</span>)}
      </div>
    </div>
  </section>

  <div class="paper-actions">
    <div class="wrap">
      <div class="left">
        <strong>{data.venue} {data.year}</strong>
        <span>{data.authors.join(", ")}</span>
      </div>
      <div class="actions">
        {
          data.pdfPath ? (
            <a class="btn solid" href={data.pdfPath} download>
              {tt("pub.downloadPdf")}
            </a>
          ) : data.arxivPdf ? (
            <a class="btn solid" href={data.arxivPdf}>{tt("pub.pdfOnArxiv")}</a>
          ) : data.openAccessUrl ? (
            <a class="btn solid" href={data.openAccessUrl}>{tt("pub.downloadPdf")}</a>
          ) : null
        }
        {data.arxivAbs && <a class="btn outline" href={data.arxivAbs}>{tt("pub.viewArxiv")}</a>}
        {!data.arxivAbs && data.doi && (
          <a class="btn outline" href={`https://doi.org/${data.doi}`}>{tt("pub.viewDoi")}</a>
        )}
        {data.semanticScholarId && (
          <a
            class="btn outline"
            href={`https://www.semanticscholar.org/paper/${data.semanticScholarId}`}
            >{tt("pub.viewSS")}</a
          >
        )}
        {data.arxivHtml && <a class="btn outline" href={data.arxivHtml}>{tt("pub.html")}</a>}
        <button class="btn outline" type="button" data-copy-bibtex data-copied-label={tt("pub.copied")}>{tt("pub.copyBibtex")}</button>
      </div>
    </div>
  </div>

  <section class="paper-body">
    <div class="wrap">
      <div class="paper-main">
        <div class="abstract-block">
          <div class="label">{tt("pub.abstract")}</div>
          <p>{data.abstract}</p>
        </div>

        {
          relatedArticle && (
            <div class="paper-section">
              <h2>{tt("article.companionHeading")}</h2>
              <a class="btn outline" href={`${articleBase}/${relatedArticle.data.slug}`}>
                {relatedArticle.data.title} →
              </a>
            </div>
          )
        }

        <div class="paper-section">
          <h2>{tt("pub.citationHeading")}</h2>
          <p style="max-width:36em;">{tt("pub.citationBody")}</p>
          <pre class="citation-block" data-bibtex>{bibtex}</pre>
        </div>

        <div class="paper-section">
          <h2>{tt("pub.ackHeading")}</h2>
          <p>{tt("pub.ackBody")}</p>
        </div>
      </div>

      <aside class="paper-sidebar">
        <div class="sidebar-card">
          <h4>{tt("pub.detailsHeading")}</h4>
          <div class="meta-row"><span class="k">{tt("pub.venue")}</span><span class="v">{data.venue}</span></div>
          <div class="meta-row"><span class="k">{tt("pub.year")}</span><span class="v">{data.year}</span></div>
          <div class="meta-row"><span class="k">{tt("pub.type")}</span><span class="v">{data.type}</span></div>
          {data.arxivId && (
            <div class="meta-row"><span class="k">{tt("pub.arxivId")}</span><span class="v">{data.arxivId}</span></div>
          )}
          {data.primaryCategory && (
            <div class="meta-row"><span class="k">{tt("pub.category")}</span><span class="v">{data.primaryCategory}</span></div>
          )}
          {data.doi && (
            <div class="meta-row"><span class="k">{tt("pub.doi")}</span><span class="v">{data.doi}</span></div>
          )}
        </div>

        <div class="sidebar-card">
          <h4>{tt("pub.authors")}</h4>
          {
            data.authors.map((a) => {
              const p = findPersonByAuthorTag(a, people);
              if (!p) {
                return (
                  <div class="author-mini" style="cursor:default;">
                    <div class="av" style="background: var(--paper-2);" />
                    <div class="info">
                      <span class="n">{a}</span>
                      <span class="r">{tt("pub.externalAuthor")}</span>
                    </div>
                  </div>
                );
              }
              return (
                <a class="author-mini" href={`${profileBase}/${p.id}`}>
                  <div class="av"><Avatar name={p.data.name} /></div>
                  <div class="info">
                    <span class="n">{p.data.name}</span>
                    <span class="r">{tt(`roleFull.${p.data.role}` as StringKey)}</span>
                  </div>
                </a>
              );
            })
          }
        </div>

        {
          related.length > 0 && (
            <div class="sidebar-card">
              <h4>{tt("pub.related")}</h4>
              <div class="related-papers">
                {related.map((r) => (
                  <a href={`${pubBase}/${r.data.slug}`}>
                    <div class="t">{r.data.title}</div>
                    <div class="v"><strong>{r.data.venue}</strong> · {r.data.year}</div>
                  </a>
                ))}
              </div>
            </div>
          )
        }

        <div style="margin-top:24px;">
          <a class="btn outline" href={`${langHome}#publications`} style="width:100%; justify-content:center;"
            >{tt("pub.backAll")}</a
          >
        </div>
      </aside>
    </div>
  </section>
</Layout>

<script>
  const btn = document.querySelector<HTMLButtonElement>("[data-copy-bibtex]");
  const pre = document.querySelector<HTMLPreElement>("[data-bibtex]");
  if (btn && pre) {
    const orig = btn.textContent;
    const copied = btn.dataset.copiedLabel ?? "✓ Copied";
    btn.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(pre.textContent ?? "");
        btn.textContent = copied;
        setTimeout(() => (btn.textContent = orig), 2000);
      } catch {
        /* clipboard unavailable */
      }
    });
  }
</script>
