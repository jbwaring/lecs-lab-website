---
import Layout from "../../layouts/Layout.astro";
import Avatar from "../../components/Avatar.astro";
import { areaTitle, roleLabel } from "../../data/lecs";
import { articles } from "../../data/lecs";
import { getCollection, type CollectionEntry } from "astro:content";
import { fold, findPersonByAuthorTag } from "../../lib/people";

export async function getStaticPaths() {
  const pubs = await getCollection("publications");
  return pubs.map((p) => ({ params: { slug: p.data.slug }, props: { pub: p } }));
}

type Props = { pub: CollectionEntry<"publications"> };
const { pub } = Astro.props as Props;
const data = pub.data;

const people = await getCollection("people");

function makeBibtex(p: typeof data): string {
  const first = p.authors[0].split(/[\s,]/)[0].toLowerCase().replace(/[^a-z]/g, "");
  return `@misc{${first}${p.year}${p.arxivId.replace(".", "")},
  title         = {${p.title}},
  author        = {${p.authors.join(" and ")}},
  year          = {${p.year}},
  eprint        = {${p.arxivId}},
  archivePrefix = {arXiv},
  primaryClass  = {${p.primaryCategory ?? "cs.AR"}}
}`;
}

const bibtex = makeBibtex(data);

// Related: other publications sharing at least one topic, exclude self, sorted by date.
const allPubs = await getCollection("publications");
const related = allPubs
  .filter((p) => p.data.slug !== data.slug && p.data.topics.some((t) => data.topics.includes(t)))
  .sort((a, b) => (a.data.date < b.data.date ? 1 : -1))
  .slice(0, 4);

// Companion article (held set may not match; just skip if none)
const relatedArticle = articles.find((a) => a.relatedPub === data.slug);

const crumbs = [
  { href: "https://www.concordia.ca", label: "Concordia University" },
  { href: "https://www.concordia.ca/ginacody.html", label: "Gina Cody School" },
  { href: "/", label: "LECS" },
  { label: "Publication", muted: true }
];
---

<Layout
  title={`${data.title} — LECS · Concordia University`}
  description={data.abstract.slice(0, 220)}
  activeNav="publications"
  crumbs={crumbs}
  condensedFooter
>
  <section class="paper-hero">
    <div class="wrap">
      <div class="breadcrumb-mini">
        <a href="/">LECS</a>
        <span>›</span>
        <a href="/#publications">Publications</a>
        <span>›</span>
        <span>{data.year}</span>
      </div>
      <div class="type-pill">arXiv {data.primaryCategory ?? "preprint"}</div>
      <h1>{data.title}</h1>
      <div class="authors-row">
        {
          data.authors.map((a, i) => {
            const person = findPersonByAuthorTag(a, people);
            return (
              <>
                {person ? (
                  <a href={`/profile/${person.id}`}>{a}</a>
                ) : (
                  <span>{a}</span>
                )}
                {i < data.authors.length - 1 ? <span>, </span> : null}
              </>
            );
          })
        }
      </div>
      <div class="venue-row">
        <strong>arXiv:{data.arxivId}</strong> · {data.year}
      </div>
      <div class="pill-row">
        {data.topics.map((t) => <span class="topic-pill">{areaTitle[t]}</span>)}
      </div>
    </div>
  </section>

  <div class="paper-actions">
    <div class="wrap">
      <div class="left">
        <strong>arXiv {data.year}</strong>
        <span>{data.authors.join(", ")}</span>
      </div>
      <div class="actions">
        {
          data.pdfPath ? (
            <a class="btn solid" href={data.pdfPath} download>
              ↓ Download PDF
            </a>
          ) : (
            <a class="btn solid" href={data.arxivPdf}>
              ↓ PDF on arXiv
            </a>
          )
        }
        <a class="btn outline" href={data.arxivAbs}>View on arXiv ↗</a>
        {
          data.arxivHtml && (
            <a class="btn outline" href={data.arxivHtml}>HTML ↗</a>
          )
        }
        <button class="btn outline" type="button" data-copy-bibtex>Copy BibTeX</button>
      </div>
    </div>
  </div>

  <section class="paper-body">
    <div class="wrap">
      <div class="paper-main">
        <div class="abstract-block">
          <div class="label">Abstract</div>
          <p>{data.abstract}</p>
        </div>

        {
          relatedArticle && (
            <div class="paper-section">
              <h2>Companion article</h2>
              <p style="max-width:36em;">
                A research note from {relatedArticle.author} accompanies this paper and discusses
                the motivating context and the open questions that follow from the result.
              </p>
              <a class="btn outline" href={`/article/${relatedArticle.slug}`}>
                Read “{relatedArticle.title}” →
              </a>
            </div>
          )
        }

        <div class="paper-section">
          <h2>Citation</h2>
          <p style="max-width:36em;">
            If you build on this work, please cite the arXiv preprint using the entry below. The
            BibTeX can be copied to clipboard with the button at the top of this page.
          </p>
          <pre class="citation-block" data-bibtex>{bibtex}</pre>
        </div>

        <div class="paper-section">
          <h2>Acknowledgements</h2>
          <p>
            This work was supported in part by the Natural Sciences and Engineering Research
            Council of Canada (NSERC) Discovery Grants programme and by the Fonds de recherche du
            Québec — Nature et technologies (FRQNT).
          </p>
        </div>
      </div>

      <aside class="paper-sidebar">
        <div class="sidebar-card">
          <h4>Paper details</h4>
          <div class="meta-row">
            <span class="k">arXiv ID</span><span class="v">{data.arxivId}</span>
          </div>
          <div class="meta-row"><span class="k">Year</span><span class="v">{data.year}</span></div>
          <div class="meta-row">
            <span class="k">Category</span><span class="v">{data.primaryCategory ?? "—"}</span>
          </div>
          <div class="meta-row"><span class="k">Venue</span><span class="v">{data.venue}</span></div>
        </div>

        <div class="sidebar-card">
          <h4>Authors</h4>
          {
            data.authors.map((a) => {
              const p = findPersonByAuthorTag(a, people);
              if (!p) {
                return (
                  <div class="author-mini" style="cursor:default;">
                    <div class="av" style="background: var(--paper-2);" />
                    <div class="info">
                      <span class="n">{a}</span>
                      <span class="r">External collaborator</span>
                    </div>
                  </div>
                );
              }
              return (
                <a class="author-mini" href={`/profile/${p.id}`}>
                  <div class="av">
                    <Avatar name={p.data.name} />
                  </div>
                  <div class="info">
                    <span class="n">{p.data.name}</span>
                    <span class="r">{roleLabel[p.data.role]}</span>
                  </div>
                </a>
              );
            })
          }
        </div>

        {
          related.length > 0 && (
            <div class="sidebar-card">
              <h4>Related publications</h4>
              <div class="related-papers">
                {related.map((r) => (
                  <a href={`/publication/${r.data.slug}`}>
                    <div class="t">{r.data.title}</div>
                    <div class="v">
                      <strong>arXiv</strong> · {r.data.year}
                    </div>
                  </a>
                ))}
              </div>
            </div>
          )
        }

        <div style="margin-top:24px;">
          <a class="btn outline" href="/#publications" style="width:100%; justify-content:center;"
            >← All publications</a
          >
        </div>
      </aside>
    </div>
  </section>
</Layout>

<script>
  const btn = document.querySelector<HTMLButtonElement>("[data-copy-bibtex]");
  const pre = document.querySelector<HTMLPreElement>("[data-bibtex]");
  if (btn && pre) {
    btn.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(pre.textContent ?? "");
        const orig = btn.textContent;
        btn.textContent = "✓ Copied";
        setTimeout(() => (btn.textContent = orig), 2000);
      } catch {
        /* clipboard unavailable */
      }
    });
  }
</script>

<style>
  .pubs-empty {
    /* unused on this page but referenced indirectly via shared layout */
  }
</style>
