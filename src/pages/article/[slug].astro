---
import Layout from "../../layouts/Layout.astro";
import Avatar from "../../components/Avatar.astro";
import { getCollection, render, type CollectionEntry } from "astro:content";
import { detectLocale, t, fmtDate, fmtDateLong, readingTime } from "../../lib/i18n";
import type { StringKey } from "../../i18n/strings";

export async function getStaticPaths() {
  const all = await getCollection("articles");
  return all.map((article) => ({
    params: { slug: article.data.slug },
    props: { article }
  }));
}

type Props = { article: CollectionEntry<"articles"> };
const { article } = Astro.props as Props;
const data = article.data;

const lang = detectLocale(Astro.url.pathname);
const tt = (k: StringKey) => t(lang, k);
const langHome = lang === "fr" ? "/fr/" : "/";
const articleBase = lang === "fr" ? "/fr/article" : "/article";
const pubBase = lang === "fr" ? "/fr/publication" : "/publication";
const profileBase = lang === "fr" ? "/fr/profile" : "/profile";
const articlesIndex = lang === "fr" ? "/fr/articles" : "/articles";

const people = await getCollection("people");
const publications = await getCollection("publications");
const allArticles = await getCollection("articles");

const author = people.find((p) => p.data.name === data.author);
const pub = data.relatedPub
  ? publications.find((p) => p.data.slug === data.relatedPub)
  : undefined;
const related = allArticles
  .filter(
    (a) =>
      a.data.slug !== data.slug && a.data.topics.some((tp) => data.topics.includes(tp))
  )
  .slice(0, 3);

const { Content } = await render(article);
const minutes = readingTime(article.body ?? "");

const crumbs = [
  { href: "https://www.concordia.ca", label: tt("util.breadcrumb.concordia") },
  { href: "https://www.concordia.ca/ginacody.html", label: tt("util.breadcrumb.gcs") },
  { href: langHome, label: "LECS" },
  { href: articlesIndex, label: tt("nav.articles") }
];
---

<Layout
  title={`${data.title} — LECS · Concordia University`}
  description={data.excerpt}
  activeNav="articles"
  crumbs={crumbs}
  condensedFooter
  locale={lang}
>
  <section class="paper-hero">
    <div class="wrap">
      <div class="breadcrumb-mini">
        <a href={articlesIndex}>{tt("nav.articles")}</a>
        <span>›</span>
        <span>{fmtDateLong(data.date, lang)}</span>
      </div>
      <div class="type-pill">{data.tag}</div>
      <h1>{data.title}</h1>
      <div class="authors-row">
        {tt("articles.by")} {
          author ? (
            <a href={`${profileBase}/${author.id}`}>{data.author}</a>
          ) : (
            <span>{data.author}</span>
          )
        }
      </div>
      <div class="venue-row">
        {fmtDateLong(data.date, lang)} · {minutes} {tt("articles.minRead")}
      </div>
      <div class="pill-row">
        {data.topics.map((tp) => <span class="topic-pill">{tt(`area.${tp}` as StringKey)}</span>)}
      </div>
    </div>
  </section>

  <section class="paper-body">
    <div class="wrap">
      <div class="paper-main">
        <div class="abstract-block">
          <div class="label">{tt("article.inBrief")}</div>
          <p>{data.excerpt}</p>
        </div>

        <div class="paper-section">
          <Content />
        </div>

        {
          pub && (
            <div class="key-points">
              <div class="label">{tt("article.companionHeading")}</div>
              <div
                style="display:flex; justify-content:space-between; align-items:center; gap:24px; padding-top:6px;"
              >
                <div>
                  <div
                    style="font-family: var(--accent); font-weight:500; font-size:18px; color: var(--ink); margin-bottom:4px;"
                  >
                    {pub.data.title}
                  </div>
                  <div style="font-size:14px; color: var(--ink-3);">
                    <strong style="color: var(--maroon); font-weight:500;">{pub.data.venue}</strong>
                    · {pub.data.year} · {pub.data.authors.join(", ")}
                  </div>
                </div>
                <a class="btn solid" href={`${pubBase}/${pub.data.slug}`} style="flex-shrink:0;">
                  {tt("pub.openPaper")}
                </a>
              </div>
            </div>
          )
        }

        <div class="paper-section">
          <h2>{tt("article.commentsHeading")}</h2>
          <p>{tt("article.commentsBody")}</p>
        </div>
      </div>

      <aside class="paper-sidebar">
        <div class="sidebar-card">
          <h4>{tt("article.author")}</h4>
          {
            author ? (
              <a class="author-mini" href={`${profileBase}/${author.id}`}>
                <div class="av"><Avatar name={author.data.name} /></div>
                <div class="info">
                  <span class="n">{author.data.name}</span>
                  <span class="r">{tt(`roleFull.${author.data.role}` as StringKey)}</span>
                </div>
              </a>
            ) : (
              <div style="font-size:14px;">{data.author}</div>
            )
          }
        </div>

        <div class="sidebar-card">
          <h4>{tt("article.thisArticle")}</h4>
          <div class="meta-row">
            <span class="k">{tt("article.published")}</span>
            <span class="v">{fmtDateLong(data.date, lang)}</span>
          </div>
          <div class="meta-row">
            <span class="k">{tt("article.category")}</span>
            <span class="v">{data.tag}</span>
          </div>
          <div class="meta-row">
            <span class="k">{tt("article.readingTime")}</span>
            <span class="v">{minutes} min</span>
          </div>
        </div>

        {
          related.length > 0 && (
            <div class="sidebar-card">
              <h4>{tt("article.related")}</h4>
              <div class="related-papers">
                {related.map((r) => (
                  <a href={`${articleBase}/${r.data.slug}`}>
                    <div class="t">{r.data.title}</div>
                    <div class="v">
                      <strong>{r.data.tag}</strong> · {fmtDate(r.data.date, lang)}
                    </div>
                  </a>
                ))}
              </div>
            </div>
          )
        }

        <div style="margin-top:24px;">
          <a class="btn outline" href={articlesIndex} style="width:100%; justify-content:center;"
            >{tt("articles.allArticles")}</a
          >
        </div>
      </aside>
    </div>
  </section>
</Layout>
